# Sales performance dashboard — environment variables. Real values never go into the repository:
# locally use a .env file (git-ignored), in production use the platform's secrets.
# With no variables set at all, the app runs on synthetic demo data.

# ── Data source: demo (default) — synthetic data, no infrastructure required;
#    olap — OLAP cube + DWH (variables below).
DATA_SOURCE=demo
# Demo: last month of generated history (YYYYMM), default 202610.
# DEMO_LAST_YM=202610

# ── OLAP cube (SSAS Tabular, XMLA over HTTP via msmdpump) — DATA_SOURCE=olap only.
OLAP_URL=
OLAP_USER=
OLAP_PASS=
OLAP_CATALOG=
# OLAP_TIMEOUT_MS=60000
# OLAP_MAX_PARALLEL=3

# ── DWH (MS SQL) — strategic plan, forecast, trademarks, base prices (DATA_SOURCE=olap).
#    Without it these blocks stay empty; everything else works.
DWH_HOST=
DWH_PORT=1433
DWH_DB=
DWH_USER=
DWH_PASS=
# DWH_ENCRYPT=false
# DWH_TIMEOUT_MS=120000
# Names of plan/forecast scenarios and budget items as stored in the DWH (code has defaults).
# DWH_STRAT_SCENARIO=
# DWH_STRAT_ARTICLE=
# REPORT_FORECAST_SCENARIO=
# REPORT_FORECAST_VIDPLANA=
# BASE_PRICE_VID=            GUID of the primary base price type
# BASE_PRICE_VID_FB=         GUID of the fallback base price type

# ── Report parameters
# REPORT_PLAN_YEAR=2026
# REPORT_FORECAST_YEAR=2026
# REPORT_PLAN_ARTICLE=       budget item of the operational plan (default derived from the plan year)
# REPORT_FIN_GROUPS=         comma-separated financial accounting groups counted as sales
# Snapshot TTL, default 6 hours: a stale snapshot is served immediately, a fresh one is built in the background.
# REPORT_SALES_TTL_MS=21600000

# ── Access. Identity comes from X-Auth-Request-* headers (when an SSO proxy sits in front of the app),
#    otherwise the user is "local". Comma-separated groups, any one is enough; empty — open access.
#    Enable only if the app cannot be reached bypassing the proxy.
# REQUIRED_TEAM=

# Port and address the app listens on.
PORT=3000
# HOST=0.0.0.0
# NODE_ENV=development — the report template is re-read from disk on every request.
